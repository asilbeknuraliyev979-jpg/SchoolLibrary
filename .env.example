# APP_URL: Primary production domain (used for strict CORS allowlist).
APP_URL="https://schoolibrary.vercel.app"

# ALLOWED_ORIGIN: Optional comma-separated list of additional allowed CORS origins.
ALLOWED_ORIGIN="https://schoolibrary.vercel.app"

# SESSION_SECRET: Required in production/Vercel! 32+ character cryptographically random secret
# used to sign HttpOnly librarian session cookies consistently across serverless instances.
SESSION_SECRET="REPLACE_WITH_SECURE_32_PLUS_CHAR_RANDOM_SECRET"

# LIBRARIAN_USERNAME: Primary librarian login username (defaults to nodira.library).
LIBRARIAN_USERNAME="nodira.library"

# LIBRARIAN_PASSWORD: Optional production bootstrap password (min 8 chars) for stateless Vercel cold starts.
# Set this in Vercel Environment Variables (Production/Preview) — never commit real passwords.
LIBRARIAN_PASSWORD=""

# ALLOWED_GOOGLE_EMAILS: Optional comma-separated Google emails allowed if Google sign-in is enabled.
# Leave empty to keep /api/auth/google disabled by default.
ALLOWED_GOOGLE_EMAILS=""

# LIBRARY_DATA_DIR: Optional writable data directory override (defaults to .data locally, /tmp/school-library-data on Vercel).
LIBRARY_DATA_DIR=""
